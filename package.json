{
	"name": "pi-poly-agent",
	"version": "0.4.1",
	"private": true,
	"type": "module",
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"pi": "node --import tsx scripts/cli.ts pi",
		"bootstrap": "node --import tsx scripts/cli.ts bootstrap",
		"qualify": "node --import tsx scripts/cli.ts qualify",
		"validate": "node --import tsx scripts/cli.ts validate",
		"start": "node --import tsx scripts/cli.ts launch",
		"test": "node --import ./tests/isolate.mjs --import tsx --test tests/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src scripts tests",
		"format:check": "prettier --check .",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test",
		"recipe": "node --import tsx scripts/cli.ts recipe"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "2.6.0",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@modelcontextprotocol/sdk": "1.32.2",
		"pi-claude-bridge": "0.13.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@eslint/js": "9.39.1",
		"eslint": "9.39.1",
		"prettier": "3.6.2",
		"tsx": "4.22.4",
		"typescript": "5.9.3",
		"typescript-eslint": "8.73.0"
	}
}
