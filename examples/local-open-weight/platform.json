{
	"version": 1,
	"recipes": ["minimal"],
	"context": ["native"],
	"providers": [
		{
			"id": "local-model",
			"adapter": "openai-compatible",
			"billing": "local",
			"enabled": false,
			"endpoint": "http://127.0.0.1:8000/v1",
			"models": ["REPLACE_MODEL_ID"],
			"modelLimits": { "contextWindow": 4096, "maxTokens": 512 },
			"capabilities": { "tools": false, "editing": false }
		}
	],
	"agents": {
		"local-reader": {
			"model": "local-model/REPLACE_MODEL_ID",
			"instructions": "Analyze only the supplied, approved context. Report uncertainty. No filesystem tool is available.",
			"policy": { "permissions": ["read"], "tools": [] }
		}
	}
}
